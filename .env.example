# Copy this file to `.env` in the project root before running Docker Compose.

# Django
DJANGO_SECRET_KEY=change-me-for-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
# If PostgreSQL is installed on your Windows/macOS host and Django runs in Docker,
# use host.docker.internal.
POSTGRES_DB=wellbore_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: required only for Google Map and Google Satellite modes.
VITE_GOOGLE_MAPS_API_KEY=
