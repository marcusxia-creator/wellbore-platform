# Copy this file to `.env` in the project root before running Docker Compose.

# Django
DJANGO_SECRET_KEY=change-me-for-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
# If PostgreSQL is installed on your Windows/macOS host and Django runs in Docker,
# use host.docker.internal.
POSTGRES_DB=wellbore_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# Frontend (baked into the client bundle at image build time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_USE_MOCK=false
